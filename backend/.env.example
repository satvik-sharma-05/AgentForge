# Copy to .env for local dev. In production set these as environment variables on Render instead.

# Supabase Postgres (app tables + LangGraph checkpoints + long-term memory store).
# Use the SESSION POOLER string (Supabase -> Connect -> Session pooler); it works over IPv4 (Render needs this).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Security. Generate once and never change ENCRYPTION_KEY (saved credentials are encrypted with it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                  -> SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     -> ENCRYPTION_KEY
SECRET_KEY=
ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=1440

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Optional default keys, used when a user hasn't added their own in the UI
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
